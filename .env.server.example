# ============================================================
#  闲鱼监控 - 服务器版配置模板（本地扫码模式）
# ============================================================
# 使用方法：
#   1. 复制为 .env.server   cp .env.server.example .env.server
#   2. 填入真实的推送密钥（Bark/邮件等，至少一个）
#   3. 本地登录 → 上传 browser_profile/data → docker compose 启动
# 详细步骤见 deploy/server-deploy.md
# 注意：本文件含可能为真实密钥的占位符，勿提交 .env.server。
# ============================================================

# Dashboard API 鉴权（可选；监听 0.0.0.0 时强烈建议开启）
DASHBOARD_TOKEN=

# ── 监控商品（服务器单品模式）────────────────────────────
# 设置 MONITOR_KEYWORD 后，程序只监控该单商品，忽略 config.py 默认列表。
MONITOR_KEYWORD="DGX spark"
# 价格范围：25000 ~ 30000（元）
MONITOR_MIN_PRICE=25000
MONITOR_MAX_PRICE=30000
# 标题包含这些词的跳过（逗号分隔）
MONITOR_EXCLUDE_KEYWORDS="询价,私聊"
# 标题必须包含词（逗号分隔；不需要则留空）
MONITOR_MUST_INCLUDE=

# ── 浏览器模式 ──────────────────────────────────────────
# 服务器用容器内 Xvfb 虚拟显示跑"有头"浏览器（规避闲鱼无头拦截），固定 0。
MONITOR_HEADLESS=0
# 有头窗口在服务器无桌面，监听不需隐藏（与桌面版无关）
MONITOR_HIDE_WINDOW=0
MONITOR_BROWSER_PROFILE=/app/browser_profile
MONITOR_DATA_DIR=/app/data
# 本地导出并上传的明文登录 cookie（tools/export_cookies.py 生成），容器启动时注入
MONITOR_COOKIES_FILE=/app/cookies.json

# ── 监控节奏 ─────────────────────────────────────────────
MONITOR_INTERVAL_MINUTES=30
# 每轮抓取的商品数量上限（闲鱼为无限滚动，滚轮次越多抓到越多）
MONITOR_MAX_ITEMS=100
# 搜索页滚动轮次（持续滚动直到没有新商品或达到轮次；0=仅首屏）
MONITOR_SCROLL_ROUNDS=8

# ── 推送通知（至少开启一个）────────────────────────────────
# Bark（iOS）
BARK_ENABLED=0
BARK_KEY=your_bark_key_here
BARK_SERVER=https://api.day.app

# PushPlus（微信）
PUSHPLUS_ENABLED=0
PUSHPLUS_TOKEN=your_pushplus_token_here

# SMTP 邮件
SMTP_ENABLED=0
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_code
SMTP_TO=your_email@qq.com

# Telegram
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── 运行环境 ─────────────────────────────────────────────
TZ=Asia/Shanghai