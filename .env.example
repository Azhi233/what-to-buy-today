# Copy to .env and fill real values. Do NOT commit .env.
# Used by docker compose (env_file) and optionally by systemd EnvironmentFile.

# Dashboard auth (optional; empty = no auth, suitable only for 127.0.0.1)
DASHBOARD_TOKEN=

# Bark (iOS)
BARK_ENABLED=0
BARK_KEY=your_bark_key_here
BARK_SERVER=https://api.day.app

# PushPlus (WeChat)
PUSHPLUS_ENABLED=0
PUSHPLUS_TOKEN=your_pushplus_token_here

# SMTP
SMTP_ENABLED=0
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_code
SMTP_TO=your_email@qq.com

# Telegram
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Monitor runtime
MONITOR_INTERVAL_MINUTES=30
# 容器无显示环境，请保持 1；本机有头模式可设为 0
MONITOR_HEADLESS=1
MONITOR_BROWSER_PROFILE=./browser_profile
MONITOR_DATA_DIR=./data
MONITOR_MAX_ITEMS=60
